# Copy to .env and fill in ONE provider. Leave LLM_PROVIDER=offline to run without any API key.
LLM_PROVIDER=offline          # offline | anthropic | openai | gemini | groq | openrouter | ollama
# LLM_MODEL=                  # optional override of the provider's default model

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=               # free tier: https://aistudio.google.com/apikey
GROQ_API_KEY=
OPENROUTER_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1   # for Ollama / LM Studio / vLLM
